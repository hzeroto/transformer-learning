+    def test_pre_output_is_normalized_but_post_path_differs(self):
+        """pre 模型末尾过 LN，故进入词表投影前的表示逐 token 均值近似为零。"""
+        pre, post = build_two_styles(len(VOCAB), 4, 2, 8, 3, 8, seed=5, dtype=DTYPE)
